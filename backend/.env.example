# Copy to .env for local development; never commit real credentials.
DATABASE_URL=sqlite:///./resumeai.db
# Set DATABASE_BACKEND=firestore to use ordinary Firebase Firestore as primary storage.
# No billing account, Cloud SQL, Functions or Cloud Storage are required for structured data.
DATABASE_BACKEND=sql
FIREBASE_PROJECT_ID=nitre-d8cdd
FIREBASE_DATABASE_ID=(default)
FIREBASE_NAMESPACE=v1
# Optional local ADC file path; credentials must stay OUTSIDE this repository.
# FIREBASE_CREDENTIALS_FILE=/absolute/private/path/google-credentials.json
# Production / Docker Compose uses postgresql+psycopg://...
STORAGE_DIR=./private-storage
MAX_UPLOAD_MB=10
MAX_PAGES=30
MAX_TEXT_CHARS=100000
EXTRACTION_TIMEOUT=90
RETENTION_HOURS=24
GUEST_LIMIT_PER_HOUR=30
SECURE_COOKIE=false
ALLOWED_ORIGIN=http://localhost:5173
# OpenAI-compatible service, called only with explicit per-analysis consent.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
SCORING_WEIGHTS={"structure":20,"keywords":25,"experience":20,"skills":15,"readability":15,"contact":5}
ACCOUNTS_ENABLED=true
GUEST_ALLOWED=true
ACCOUNT_RETENTION_DAYS=365
SESSION_DAYS=30
PUBLIC_URL=http://localhost:5173
ALLOWED_HOSTS=["localhost","127.0.0.1","backend","testserver"]
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Formiqo <noreply@example.com>
SMTP_STARTTLS=true
# Office options appear only after an enabled LibreOffice + bubblewrap preflight succeeds.
OFFICE_ENABLED=false
CONVERSION_TIMEOUT=120
