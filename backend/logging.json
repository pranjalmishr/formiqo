{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {"safe_access": {"()": "app.observability.SafeAccessFilter"}},
  "formatters": {
    "private": {"()": "app.observability.RedactingFormatter", "format": "%(asctime)s %(levelname)s %(name)s %(message)s"}
  },
  "handlers": {
    "console": {"class": "logging.StreamHandler", "formatter": "private", "stream": "ext://sys.stdout"},
    "access": {"class": "logging.StreamHandler", "formatter": "private", "filters": ["safe_access"], "stream": "ext://sys.stdout"}
  },
  "loggers": {
    "uvicorn": {"handlers": ["console"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["console"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": ["access"], "level": "INFO", "propagate": false},
    "formiqo": {"handlers": ["console"], "level": "INFO", "propagate": false}
  },
  "root": {"handlers": ["console"], "level": "WARNING"}
}
